# =============================================================================
# SLMS Backend Environment Variables (Local Development)
# =============================================================================
# This file contains environment variables for running the backend locally
# (outside Docker). Copy this to .env and update values as needed.
#
# NOTE: For Docker deployment, use infra/.env instead
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Use localhost with exposed port for local development
DB_HOST=localhost
DB_PORT=5433
DB_NAME=slms
DB_USERNAME=slms
DB_PASSWORD=slms

# -----------------------------------------------------------------------------
# JPA Configuration
# -----------------------------------------------------------------------------
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# -----------------------------------------------------------------------------
# Keycloak Configuration
# -----------------------------------------------------------------------------
# For local development outside Docker, use localhost with exposed port (8180)
# For Docker containers, use keycloak:8080 (internal Docker network)
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8180
KEYCLOAK_REALM=slms
KEYCLOAK_ADMIN_CLIENT_ID=slms-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=get_from_keycloak_dashboard_or_realm_export

# JWT Token Validation
# CRITICAL: Must match the 'iss' claim in JWT tokens issued by Keycloak
# For local dev outside Docker: Use http://localhost:8180 (matches KC_HOSTNAME_URL)
# Keycloak issues tokens with iss claim based on KC_HOSTNAME_URL setting in infra/.env
JWT_ISSUER_URI=http://localhost:8180/realms/slms

# -----------------------------------------------------------------------------
# MinIO Configuration
# -----------------------------------------------------------------------------
# Use localhost with exposed port for local development
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminsecret
MINIO_BUCKET=slms-documents
MINIO_PORT=9000
MINIO_HOST=localhost

# -----------------------------------------------------------------------------
# Chatbot Module - AI & Vector Database Configuration
# -----------------------------------------------------------------------------
# Google Gemini AI Configuration
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Pinecone Vector Database Configuration
# Get your API key from: https://app.pinecone.io/
# Setup Instructions:
# 1. Create a free account at https://www.pinecone.io/
# 2. Create an index with the following settings:
#    - Dimensions: 768 (recommended for gemini-embedding-001)
#      Note: gemini-embedding-001 defaults to 3072 but can scale to 768 or 1536
#    - Metric: cosine
#    - Name: slms-chatbot (or your preferred name)
# 3. From the Pinecone dashboard:
#    - Copy your API key
#    - Copy the full host URL (looks like: https://your-index-abc123.svc.region.pinecone.io)
#    - Find this in: Indexes → [Your Index] → Connect
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_HOST=https://your-index-abc123.svc.region.pinecone.io
PINECONE_INDEX=slms-chatbot
PINECONE_NAMESPACE=en-US

# Chatbot Document Seeding
# Enable automatic seeding of knowledge base documents on startup
# Set to 'true' for development, 'false' for production (seed manually once)
CHATBOT_SEEDER_ENABLED=false

# -----------------------------------------------------------------------------
# NOTES FOR LOCAL DEVELOPMENT
# -----------------------------------------------------------------------------
# 1. Start all services with: docker compose -f infra/docker-compose.dev.yml up -d
# 2. Get KEYCLOAK_ADMIN_CLIENT_SECRET from:
#    - Keycloak dashboard: Clients → slms-backend → Credentials tab
#    - Or from infra/keycloak/realm-export.json (search for "slms-backend" client)
# 3. Ensure JWT_ISSUER_URI matches the Keycloak external URL (port 8180)
# 4. Database port 5433 is exposed from Docker (internal port is 5432)
# 5. Set GEMINI_API_KEY and PINECONE_API_KEY for chatbot functionality

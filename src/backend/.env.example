
# Database Configuration
POSTGRES_DB=slms
POSTGRES_USER=slms
POSTGRES_PASSWORD=slms
POSTGRES_PORT=5433
DB_HOST=localhost
DB_PORT=5433
DB_NAME=slms
DB_USERNAME=slms
DB_PASSWORD=slms

# JPA Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# Keycloak Service Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://localhost:5433/slms
KC_DB_USERNAME=slms
KC_DB_PASSWORD=slms
KC_HOSTNAME=localhost
KC_PROXY=edge

# Keycloak Application Configuration
# For local development outside Docker, use localhost:8180
# For Docker containers, use keycloak:8080 (internal Docker network)
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8180
KEYCLOAK_REALM=slms
KEYCLOAK_ADMIN_CLIENT_ID=slms-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=your-client-secret-here

# Backend Service
BACKEND_PORT=8080

# Frontend Services
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=production

# MINIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminsecret
MINIO_BUCKET=documents
MINIO_PORT=9000
MINIO_HOST=localhost

# Outros serviços (admin-console, costumer-portal, driver-pwa, landing-page)
# Adicione variáveis específicas se necessário

# Nginx
# Nenhuma variável obrigatória para nginx por default
# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=slms
DB_USERNAME=slms
DB_PASSWORD=slms

# JPA Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# Keycloak Configuration
# For local development outside Docker, use localhost:8180
# For Docker containers, use keycloak:8080 (internal Docker network)
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8180
KEYCLOAK_REALM=slms
KEYCLOAK_CLIENT_ID=slms-backend
# Get this from Keycloak Admin Console -> Clients -> slms-backend -> Credentials tab
KEYCLOAK_CLIENT_SECRET=your-client-secret-from-keycloak

# Keycloak Admin Client Configuration (for user management)
# Use the same client credentials if Service Accounts Roles is enabled on the client
# Or create a separate admin client in Keycloak
KEYCLOAK_ADMIN_CLIENT_ID=slms-backend
# Should be the same as KEYCLOAK_CLIENT_SECRET if using the same client
KEYCLOAK_ADMIN_CLIENT_SECRET=your-client-secret-from-keycloak
# =============================================================================
# SLMS Backend Environment Variables (Local Development)
# =============================================================================
# This file contains environment variables for running the backend locally
# (outside Docker). Copy this to .env and update values as needed.
#
# NOTE: For Docker deployment, use infra/.env instead
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Use localhost with exposed port for local development
DB_HOST=localhost
DB_PORT=5433
DB_NAME=slms
DB_USERNAME=slms
DB_PASSWORD=slms

# -----------------------------------------------------------------------------
# JPA Configuration
# -----------------------------------------------------------------------------
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# -----------------------------------------------------------------------------
# Keycloak Configuration
# -----------------------------------------------------------------------------
# For local development outside Docker, use localhost with exposed port (8180)
# For Docker containers, use keycloak:8080 (internal Docker network)
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8180
KEYCLOAK_REALM=slms
KEYCLOAK_ADMIN_CLIENT_ID=slms-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=get_from_keycloak_dashboard_or_realm_export

# JWT Token Validation
# CRITICAL: Must match the 'iss' claim in JWT tokens issued by Keycloak
# For local dev outside Docker: Use http://localhost:8180 (matches KC_HOSTNAME_URL)
# Keycloak issues tokens with iss claim based on KC_HOSTNAME_URL setting in infra/.env
JWT_ISSUER_URI=http://localhost:8180/realms/slms

# -----------------------------------------------------------------------------
# MinIO Configuration
# -----------------------------------------------------------------------------
# Use localhost with exposed port for local development
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminsecret
MINIO_BUCKET=slms-documents
MINIO_PORT=9000
MINIO_HOST=localhost

# -----------------------------------------------------------------------------
# NOTES FOR LOCAL DEVELOPMENT
# -----------------------------------------------------------------------------
# 1. Start all services with: docker compose -f infra/docker-compose.dev.yml up -d
# 2. Get KEYCLOAK_ADMIN_CLIENT_SECRET from:
#    - Keycloak dashboard: Clients → slms-backend → Credentials tab
#    - Or from infra/keycloak/realm-export.json (search for "slms-backend" client)
# 3. Ensure JWT_ISSUER_URI matches the Keycloak external URL (port 8180)
# 4. Database port 5433 is exposed from Docker (internal port is 5432)

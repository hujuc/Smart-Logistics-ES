# Shared environment variables for all frontend projects
# Copy this file to each project's .env.local and customize as needed

# API Configuration (adjust per project if needed)
NEXT_PUBLIC_API_URL=http://localhost/api

# Keycloak Configuration (shared across all projects)
KEYCLOAK_CLIENT_ID=slms-backend
KEYCLOAK_CLIENT_SECRET=dev-secret-change
KEYCLOAK_ISSUER=http://localhost/realms/slms
KEYCLOAK_BASE_URL=http://localhost
KEYCLOAK_REALM=slms
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# NextAuth Configuration (customize per project)
# NEXTAUTH_URL=http://localhost/admin  # admin-console
# NEXTAUTH_URL=http://localhost/portal  # customer-portal
# NEXTAUTH_URL=http://localhost/driver  # driver-pwa
NEXTAUTH_SECRET=your-secret-key-change-this-in-production

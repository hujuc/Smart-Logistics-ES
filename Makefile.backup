# Makefile para Gestão de Backups
# Este arquivo contém comandos úteis para gestão de backups

.PHONY: help backup backup-list backup-restore backup-download backup-clean backup-logs

help:
	@echo "Comandos disponíveis para gestão de backups:"
	@echo ""
	@echo "  make backup              - Criar backup manual da base de dados"
	@echo "  make backup-list         - Listar todos os backups disponíveis"
	@echo "  make backup-restore      - Restaurar um backup (especifique BACKUP_FILE=<nome>)"
	@echo "  make backup-download     - Download de backup (especifique BACKUP_FILE=<nome>)"
	@echo "  make backup-clean        - Remover backups antigos (mais de 30 dias)"
	@echo "  make backup-logs         - Ver logs do serviço de backup"
	@echo "  make backup-space        - Verificar espaço usado por backups"
	@echo ""
	@echo "Exemplos:"
	@echo "  make backup"
	@echo "  make backup-restore BACKUP_FILE=backup_slms_20240129_120000.sql.gz"
	@echo "  make backup-download BACKUP_FILE=backup_slms_20240129_120000.sql.gz"
	@echo ""

backup:
	@echo "🔄 Criando backup manual..."
	docker compose -f infra/docker-compose.yaml exec backup /usr/local/bin/backup.sh

backup-list:
	@echo "📋 Backups disponíveis:"
	@docker compose -f infra/docker-compose.yaml exec backup ls -lh /backups

backup-restore:
ifndef BACKUP_FILE
	@echo "❌ Erro: Especifique o arquivo de backup com BACKUP_FILE=<nome>"
	@echo "Exemplo: make backup-restore BACKUP_FILE=backup_slms_20240129_120000.sql.gz"
	@echo ""
	@echo "Backups disponíveis:"
	@docker compose -f infra/docker-compose.yaml exec backup ls -lh /backups
	@exit 1
endif
	@echo "🔄 Restaurando backup: $(BACKUP_FILE)"
	@echo "⚠️  ATENÇÃO: Esta operação irá substituir todos os dados atuais!"
	@docker compose -f infra/docker-compose.yaml exec backup /usr/local/bin/restore.sh $(BACKUP_FILE)

backup-download:
ifndef BACKUP_FILE
	@echo "❌ Erro: Especifique o arquivo de backup com BACKUP_FILE=<nome>"
	@echo "Exemplo: make backup-download BACKUP_FILE=backup_slms_20240129_120000.sql.gz"
	@exit 1
endif
	@echo "📥 Fazendo download do backup: $(BACKUP_FILE)"
	docker cp slms-backup:/backups/$(BACKUP_FILE) ./$(BACKUP_FILE)
	@echo "✅ Backup salvo em: ./$(BACKUP_FILE)"

backup-clean:
	@echo "🧹 Removendo backups com mais de 30 dias..."
	docker compose -f infra/docker-compose.yaml exec backup find /backups -name "backup_*.sql.gz" -mtime +30 -delete
	@echo "✅ Limpeza concluída"

backup-logs:
	@echo "📜 Logs do serviço de backup:"
	docker compose -f infra/docker-compose.yaml logs --tail=50 -f backup

backup-space:
	@echo "💾 Espaço usado por backups:"
	@docker compose -f infra/docker-compose.yaml exec backup du -sh /backups
	@echo ""
	@echo "Detalhes:"
	@docker compose -f infra/docker-compose.yaml exec backup du -h /backups/*.sql.gz 2>/dev/null || echo "Nenhum backup encontrado"

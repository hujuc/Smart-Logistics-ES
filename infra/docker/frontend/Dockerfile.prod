# Multi-stage production Dockerfile for Next.js frontends
# Build context: repository root
# Usage: docker build -f infra/docker/frontend/Dockerfile.prod --build-arg FRONTEND_PATH=src/frontend/landing-page .
#
# This unified Dockerfile supports all 4 frontend apps:
# - landing-page
# - admin-console
# - customer-portal
# - driver-pwa

ARG NODE_VERSION=20
ARG FRONTEND_PATH=src/frontend/landing-page

# ===== Dependencies Stage =====
FROM node:${NODE_VERSION}-alpine AS deps
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

ARG FRONTEND_PATH
COPY ${FRONTEND_PATH}/package.json ./package.json
COPY ${FRONTEND_PATH}/package-lock.json* ./package-lock.json
RUN npm ci

# ===== Builder Stage =====
FROM node:${NODE_VERSION}-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# Accept all possible build arguments for Next.js public environment variables
# These will be inlined at build time by Next.js
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_FLAGSMITH_ENV_KEY
ARG NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN
ARG KEYCLOAK_BASE_URL
ARG NEXTAUTH_URL
ARG NEXT_PUBLIC_ELASTIC_APM_SERVER_URL
ARG NEXT_PUBLIC_ELASTIC_APM_SECRET_TOKEN
ARG NEXT_PUBLIC_DEPLOYMENT_ENV
ARG NEXT_PUBLIC_PROJECT_VERSION
ARG NEXT_PUBLIC_TRACING_SAMPLING_RATE

# Set as environment variables so Next.js can embed them during build
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_FLAGSMITH_ENV_KEY=$NEXT_PUBLIC_FLAGSMITH_ENV_KEY
ENV NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=$NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN
ENV KEYCLOAK_BASE_URL=$KEYCLOAK_BASE_URL
ENV NEXTAUTH_URL=$NEXTAUTH_URL
ENV NEXT_PUBLIC_ELASTIC_APM_SERVER_URL=$NEXT_PUBLIC_ELASTIC_APM_SERVER_URL
ENV NEXT_PUBLIC_ELASTIC_APM_SECRET_TOKEN=$NEXT_PUBLIC_ELASTIC_APM_SECRET_TOKEN
ENV NEXT_PUBLIC_DEPLOYMENT_ENV=$NEXT_PUBLIC_DEPLOYMENT_ENV
ENV NEXT_PUBLIC_PROJECT_VERSION=$NEXT_PUBLIC_PROJECT_VERSION
ENV NEXT_PUBLIC_TRACING_SAMPLING_RATE=$NEXT_PUBLIC_TRACING_SAMPLING_RATE

ARG FRONTEND_PATH
COPY --from=deps /app/node_modules ./node_modules
COPY ${FRONTEND_PATH}/ ./

# Copy shared components (all frontends use shared components)
COPY src/frontend/shared ./shared

RUN npm run build

# ===== Runtime Stage =====
FROM node:${NODE_VERSION}-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Install curl for health checks
RUN apk add --no-cache curl

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]

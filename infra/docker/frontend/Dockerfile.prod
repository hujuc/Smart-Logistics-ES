# Multi-stage build for Next.js production
FROM node:20-alpine AS base

# Dependencies stage 
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

ARG FRONTEND_PATH
# Copy package files
COPY ${FRONTEND_PATH}/package.json ./package.json
COPY ${FRONTEND_PATH}/package-lock.json ./package-lock.json

# Install dependencies with error handling
RUN npm ci --legacy-peer-deps || npm install --legacy-peer-deps

# Build stage
FROM base AS builder
WORKDIR /app

ARG FRONTEND_PATH
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_FLAGSMITH_ENV_KEY
ARG NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN
ARG KEYCLOAK_BASE_URL
ARG NEXTAUTH_URL

# Copy node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json

# Copy all source files
COPY ${FRONTEND_PATH}/ ./

# Set production environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Accept build-time arguments for Next.js public env vars
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_FLAGSMITH_ENV_KEY
ARG NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN
ARG KEYCLOAK_BASE_URL
ARG NEXTAUTH_URL

# Pass them as environment variables during build (Next.js will inline them)
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_FLAGSMITH_ENV_KEY=${NEXT_PUBLIC_FLAGSMITH_ENV_KEY}
ENV NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=${NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN}

# Verify installation and build
RUN echo "=== Checking Node.js and npm ===" && \
    node --version && \
    npm --version && \
    echo "=== Checking if next is installed ===" && \
    ls -la node_modules/.bin/ | grep next || echo "Next.js not found in node_modules!" && \
    echo "=== Starting build ===" && \
    npm run build

# Production stage
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy built application
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]

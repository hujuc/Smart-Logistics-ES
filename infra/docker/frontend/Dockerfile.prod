# Multi-stage build for Next.js production
FROM node:20-alpine AS base

# Dependencies stage
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

ARG FRONTEND_PATH
COPY ${FRONTEND_PATH}/package.json ${FRONTEND_PATH}/package-lock.json* ./
# Use BuildKit cache mount for faster builds
RUN --mount=type=cache,target=/root/.npm npm ci --prefer-offline

# Build stage
FROM base AS builder
WORKDIR /app

ARG FRONTEND_PATH
COPY --from=deps /app/node_modules ./node_modules
COPY ${FRONTEND_PATH} .

# Set production environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Accept build-time arguments for Next.js public env vars
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_FLAGSMITH_ENV_KEY
ARG NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN
ARG KEYCLOAK_BASE_URL
ARG NEXTAUTH_URL
ARG NEXT_PUBLIC_ELASTIC_APM_SERVER_URL
ARG NEXT_PUBLIC_ELASTIC_APM_SECRET_TOKEN
ARG NEXT_PUBLIC_DEPLOYMENT_ENV
ARG NEXT_PUBLIC_PROJECT_VERSION
ARG NEXT_PUBLIC_TRACING_SAMPLING_RATE

# Pass them as environment variables during build (Next.js will inline them)
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_FLAGSMITH_ENV_KEY=${NEXT_PUBLIC_FLAGSMITH_ENV_KEY}
ENV NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=${NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN}
ENV NEXT_PUBLIC_ELASTIC_APM_SERVER_URL=${NEXT_PUBLIC_ELASTIC_APM_SERVER_URL}
ENV NEXT_PUBLIC_ELASTIC_APM_SECRET_TOKEN=${NEXT_PUBLIC_ELASTIC_APM_SECRET_TOKEN}
ENV NEXT_PUBLIC_DEPLOYMENT_ENV=${NEXT_PUBLIC_DEPLOYMENT_ENV}
ENV NEXT_PUBLIC_PROJECT_VERSION=${NEXT_PUBLIC_PROJECT_VERSION}
ENV NEXT_PUBLIC_TRACING_SAMPLING_RATE=${NEXT_PUBLIC_TRACING_SAMPLING_RATE}

# Build the application
RUN npm run build

# Production stage
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy built application
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]

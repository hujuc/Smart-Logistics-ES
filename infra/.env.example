# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=slms
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# MinIO Configuration
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_BUCKET=slms-documents

# Keycloak Configuration
# For containers: use internal Docker network hostname (keycloak:8080)
# For local dev outside Docker: use localhost:8180
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=slms
KEYCLOAK_ADMIN_CLIENT_ID=slms-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=your_keycloak_client_secret

# Keycloak Admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_admin_password

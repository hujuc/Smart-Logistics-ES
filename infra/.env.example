# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=slms
DB_USERNAME=slms
DB_PASSWORD=slms
POSTGRES_USER=slms
POSTGRES_DB=slms
POSTGRES_PASSWORD=slms

# MinIO Configuration
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminsecret
MINIO_BUCKET=slms-documents

# Keycloak Configuration
# For containers: use internal Docker network hostname
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=slms
KEYCLOAK_ADMIN_CLIENT_ID=slms-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=8lRdhgGz3Vs6tZzUSu11nLQeZJrH3nbd

# JWT Token Validation
# CRITICAL: Must match the 'iss' claim in JWT tokens issued by Keycloak
# Keycloak issues tokens with its internal Docker hostname
JWT_ISSUER_URI=http://keycloak:8080/realms/slms

# Keycloak Admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak Internal Config
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/slms
KC_DB_USERNAME=slms
KC_DB_PASSWORD=slms
# Frontend URL - This is what Keycloak uses for issuer in tokens
KC_HOSTNAME_URL=http://localhost:8180
KC_HOSTNAME_ADMIN_URL=http://localhost:8180
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_BACKCHANNEL=false

# QR Codes
QR_SCAN_BASE_URL=http://localhost:8080/api/driver


# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=slms
DB_USERNAME=slms
DB_PASSWORD=slms
POSTGRES_USER=slms
POSTGRES_DB=slms
POSTGRES_PASSWORD=slms

# MinIO Configuration
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminsecret
MINIO_BUCKET_NAME=slms-documents

# Keycloak Configuration
# For containers: use internal Docker network hostname
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=slms
KEYCLOAK_ADMIN_CLIENT_ID=slms-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=8lRdhgGz3Vs6tZzUSu11nLQeZJrH3nbd

# JWT Token Validation
# CRITICAL: Must match the 'iss' claim in JWT tokens issued by Keycloak
# Keycloak issues tokens with its internal Docker hostname
JWT_ISSUER_URI=http://keycloak:8080/realms/slms

# Keycloak Admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak Internal Config
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/slms
KC_DB_USERNAME=slms
KC_DB_PASSWORD=slms
# Keycloak Public Hostname Configuration
# KC_HOSTNAME: Public hostname (without protocol/port) for Keycloak
# KC_HOSTNAME_URL: Full URL that Keycloak uses for issuer in JWT tokens
# For production: Use your domain (e.g., auth.yourdomain.com)
# For local dev: Use localhost:8180
KC_HOSTNAME=localhost
KC_HOSTNAME_URL=http://localhost:8180
KC_HOSTNAME_ADMIN_URL=http://localhost:8180
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_BACKCHANNEL=false

# Shipping API Configuration
SHIPPO_API_KEY=shippo_test_22f9aba8a039b2b877a7c0f4dc6f315e398ce9f6
SANDBOX_API_KEY=TEST_9N8yvQ0JQRVvY6+Qz/96meXlTiI5DIupCVahGeo5xNY
SHIPPO_BASE_URL=https://api.goshippo.com
SHIPENGINE_API_KEY=our_shipengine_key
SHIPENGINE_BASE_URL=https://api.shipengine.com/v1

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
# Maximum number of backups to keep (older ones are automatically deleted)
MAX_BACKUPS=4

# Backup schedule: Daily at 2:00 AM (configured in docker-compose.yaml

# -----------------------------------------------------------------------------
# Frontend Environment Variables
# -----------------------------------------------------------------------------

# Frontend API Base URL
# This is the base URL that all frontend applications use to communicate with the backend
# For production: Use your public domain (e.g., https://api.yourdomain.com)
# For local dev: Use http://localhost/api
NEXT_PUBLIC_API_URL=http://localhost/api

# Customer Portal - Flagsmith Configuration
# Get your Environment Key from: Flagsmith Dashboard → Environments → Client-side Environment Key
NEXT_PUBLIC_FLAGSMITH_ENV_KEY=your_flagsmith_environment_key_here

# Driver PWA - Mapbox Configuration
# Get your token from: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# -----------------------------------------------------------------------------
# Observability Configuration (Elastic APM / OpenTelemetry)
# -----------------------------------------------------------------------------
# Elastic Cloud APM Configuration
# Get these values from your Elastic Cloud deployment:
# 1. Go to https://cloud.elastic.co/
# 2. Navigate to your deployment → APM & Fleet
# 3. Copy the APM Server URL and Secret Token
ELASTIC_APM_SERVER_URL=https://your-deployment-id.apm.elastic-cloud.com:443
ELASTIC_APM_SECRET_TOKEN=your_secret_token_here

# Deployment Environment (development, staging, production)
DEPLOYMENT_ENV=development

# Application Version
PROJECT_VERSION=0.0.1-SNAPSHOT

# Tracing Configuration
TRACING_SAMPLING_RATE=1.0

# Logging Levels
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_WEB=INFO
LOG_LEVEL_SECURITY=INFO

# -----------------------------------------------------------------------------
# DEPLOYMENT NOTES FOR DEVOPS
# -----------------------------------------------------------------------------
# 1. Generate new secrets for production (KEYCLOAK_ADMIN_CLIENT_SECRET, passwords)
# 2. Update JWT_ISSUER_URI to match your production domain
# 3. Update KC_HOSTNAME to your production domain (for Keycloak URL generation)
# 4. Ensure Keycloak realm-export.json client secret matches KEYCLOAK_ADMIN_CLIENT_SECRET
# 5. Use proper TLS certificates in production
# 6. Configure backup retention period (BACKUP_RETENTION_DAYS)
# 7. Set up external backup storage (S3, etc.) for production
# 8. Test restore procedure before going to production
# 9. Replace NEXT_PUBLIC_FLAGSMITH_ENV_KEY with production Flagsmith key
# 10. Replace NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN with production Mapbox token

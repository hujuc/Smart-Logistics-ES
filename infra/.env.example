# =============================================================================
# SLMS Infrastructure Environment Variables
# =============================================================================
# This file contains environment variables for Docker services.
# Copy this to .env and update values for your environment.
#
# IMPORTANT FOR DEVOPS:
# - All secrets should be changed in production
# - Use internal Docker network hostnames (postgres, keycloak, minio) for
#   container-to-container communication
# - JWT_ISSUER_URI must match the external URL where Keycloak is accessible
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=slms
POSTGRES_USER=slms
POSTGRES_PASSWORD=change_me_in_production

# Backend Database Connection (maps to application.properties DB_* variables)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=slms
DB_USERNAME=slms
DB_PASSWORD=change_me_in_production

# -----------------------------------------------------------------------------
# MinIO Configuration (S3-compatible Object Storage)
# -----------------------------------------------------------------------------
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_BUCKET=slms-documents

# -----------------------------------------------------------------------------
# Keycloak Configuration
# -----------------------------------------------------------------------------
# IMPORTANT: Use internal Docker network hostname for container communication
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=slms
KEYCLOAK_ADMIN_CLIENT_ID=slms-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=change_me_in_production

# JWT Token Validation
# CRITICAL: Must match the 'iss' claim in JWT tokens issued by Keycloak
# For Docker deployment: Use internal Docker hostname (keycloak:8080)
# For production VM: Use internal hostname or localhost with correct port
JWT_ISSUER_URI=http://keycloak:8080/realms/slms

# Keycloak Admin Credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_in_production

# Keycloak Internal Database Configuration
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/slms
KC_DB_USERNAME=slms
KC_DB_PASSWORD=change_me_in_production
# Frontend URL - CRITICAL: This determines the 'iss' claim in JWT tokens
# Local dev:  http://localhost:8180
# Production: https://your-domain.com
KC_HOSTNAME_URL=http://localhost:8180
KC_HOSTNAME_ADMIN_URL=http://localhost:8180
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_BACKCHANNEL=false

SHIPPO_API_KEY=our_shippo_key
SANDBOX_API_KEY=our_sandbox_key
SHIPPO_BASE_URL=https://api.goshippo.com
SHIPENGINE_API_KEY=our_shipengine_key
SHIPENGINE_BASE_URL=https://api.shipengine.com/v1

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
# Maximum number of backups to keep (older ones are automatically deleted)
MAX_BACKUPS=3

# Backup schedule: Daily at 2:00 AM (configured in docker-compose.yaml)

# -----------------------------------------------------------------------------
# PostgreSQL Container Configuration
# -----------------------------------------------------------------------------
# These are used by the PostgreSQL container itself
POSTGRES_DB=slms
POSTGRES_USER=slms
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# DEPLOYMENT NOTES FOR DEVOPS
# -----------------------------------------------------------------------------
# 1. Generate new secrets for production (KEYCLOAK_ADMIN_CLIENT_SECRET, passwords)
# 2. Update JWT_ISSUER_URI to match your production domain
# 3. Update KC_HOSTNAME to your production domain (for Keycloak URL generation)
# 4. Ensure Keycloak realm-export.json client secret matches KEYCLOAK_ADMIN_CLIENT_SECRET
# 5. Use proper TLS certificates in production
# 6. Configure backup retention period (BACKUP_RETENTION_DAYS)
# 7. Set up external backup storage (S3, etc.) for production
# 8. Test restore procedure before going to production
